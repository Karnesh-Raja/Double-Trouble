# Copy to .env (never commit .env). No secrets belong in the frontend.
PORT=4000
NODE_ENV=development
DB_PATH=./data/agrosense.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_BOOT=true

# ---- Server-side AI (decision support only; the engines calculate all numbers) ----
# Read with process.env.AI_API_KEY on the server. It is never sent to the browser, never logged, never stored.
# Leave empty to run on the deterministic fallback (the whole app still works).
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=8000        # per attempt
AI_MAX_RETRIES=1          # 0 or 1. One retry only: on invalid output or a transient 429/5xx/network error
# AI_API_URL=https://api.anthropic.com/v1/messages
# (ANTHROPIC_API_KEY is accepted as an alias for AI_API_KEY)

# Demo pricing (INR per kg) used when a shipment has no price of its own
DEFAULT_BASE_PRICE_PER_KG=150
DATABASE_URL=mysql://agro_app:pick-a-strong-password@localhost:3306/agrosense